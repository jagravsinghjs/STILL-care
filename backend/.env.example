BACKEND_MODE=mock
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Empty/missing secret uses an ephemeral random key; tokens expire on server restart.
# Local development: allow HTTP/HTTPS localhost and 127.0.0.1 on any port.
# Production: set false and list only your deployed frontend origins below.
CORS_ALLOW_LOCALHOST=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_URL=sqlite:///backend/data/still.db

# Existing supervisor assigned to newly registered students.
SIGNUP_SUPERVISOR_ID=meera

# Conversational model served locally by Ollama (integrated mode).
ASSISTANT_MODEL=qwen2.5:7b-instruct
